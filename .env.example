# Copie ce fichier en `.env` et complète les valeurs.
# Ne commit JAMAIS le fichier `.env` réel.

# Base de données (Neon, Supabase, ...)
# Neon : https://neon.tech -> New project -> copy the connection string
# ATTENTION : utiliser la string avec le pooler ou direct, sans espaces ni guillemets
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clé secrète pour signer les sessions JWT de NextAuth
# Génère-en une avec : npx auth secret  (ou : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
NEXTAUTH_SECRET="change-me"

# URL publique de l'application
# En local : http://localhost:3000
# En production (Vercel) : https://<ton-projet>.vercel.app
NEXTAUTH_URL="http://localhost:3000"
