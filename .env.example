# Copie ce fichier en `.env` et complète les valeurs.
# Ne commit JAMAIS le fichier `.env` réel.

# Base de données PostgreSQL (Neon, Supabase, ...)
# Neon : https://neon.tech -> New project -> copie la connection string.
# ATTENTION : sur Vercel, utilise la string "pooled" fournie par Neon
# (host en ...-pooler...). Sans espaces ni guillemets.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clé secrète pour signer les sessions JWT de NextAuth.
# Génère-en une avec : npx auth secret
# (ou : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
NEXTAUTH_SECRET="change-me"

# URL publique de l'application.
# En local : http://localhost:3000
# En production (Vercel) : https://<ton-projet>.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Pour appliquer le schéma (prisma/schema.prisma) à la base :
#   npm run db:push
